{
  "name": "music",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "effect": "4.1.4",
      "@effect/platform-browser": "4.1.3",
      "@effect/platform-bun": "4.1.3",
      "@types/bun": "^1.3.0",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --filter '@music/server' --filter '@music/web' dev",
    "build": "bun run --filter '@music/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "oxlint --disable-nested-config apps packages && effect-tsgo patch --no-typescript --oxlint && oxlint --disable-nested-config --config .oxlintrc.effect.json --deny-warnings apps packages",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "deploy": "./scripts/deploy-main.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "0.50.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003"
  }
}
